# Experiment reports are immutable byte artifacts; their retained SHA256 values
# must survive Windows -> Git -> Linux deployment without newline conversion.
docs/experiments/** -text whitespace=cr-at-eol
# Preserve literal model responses (including terminal whitespace) for audits.
docs/experiments/**/*.simulated.raw.json whitespace=cr-at-eol,-blank-at-eof
docs/experiments/**/agent_review/* whitespace=cr-at-eol,-blank-at-eof
