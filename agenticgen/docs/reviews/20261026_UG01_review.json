  "research": [
    {
      "url": "https://arxiv.org/html/2501.02526v1",
      "version_or_commit": "arXiv:2501.02526v1; NeurIPS 2024; equations 9-15",
      "accessed_at": "2026-10-26T20:05:49.476432+08:00",
      "primary_source": true,
      "applicability": "The clean-endpoint residual is differentiated with respect to the noisy input. Its conversion to a diffusion mean uses a model/time coefficient; transplanting the numerical diffusion scale to FLOWR is unjustified. This supports diagnosing the existing adapter, not changing it."
    },
    {
      "url": "https://proceedings.neurips.cc/paper_files/paper/2024/file/faa6276ea12d7afeb3e42b210c86f688-Supplemental-Conference.zip",
      "version_or_commit": "NeurIPS 2024 supplemental archive; SHA256 ffa7d8b0731b69defa9835bfebb089ad0200995b68270b34dd1442540f5321b3",
      "accessed_at": "2026-10-26T20:05:49.476432+08:00",
      "primary_source": true,
      "applicability": "Re-read cached official DiffSBDD/equivariant_diffusion/en_diffusion.py lines 602-624: detached condition target, autograd.grad(E_pocket,zt_pocket), and sigma2_t_given_s/alpha_t_given_s mean correction. The archive is evidence, not executable code imported into FLOWR; its sum reduction, feature guidance and mean projection differ from our frozen coordinate-only implementation."
    },
    {
      "url": "https://arxiv.org/html/2502.02150v2",
      "version_or_commit": "arXiv:2502.02150v2, 2025-04-22; section 3.3, equation 6 and appendix A.11",
      "accessed_at": "2026-10-26T20:05:49.476432+08:00",
      "primary_source": true,
      "applicability": "Endpoint-Jacobian guidance has path-dependent coefficients and explicit distribution/path assumptions. It motivates distinguishing the VJP from the integration coefficient. The Gaussian-affine theory is not claimed as an exact posterior theorem for this molecular FLOWR stochastic implementation."
    },
    {
      "url": "https://docs.pytorch.org/docs/2.9/notes/autograd.html",
      "version_or_commit": "PyTorch 2.9 documentation, updated 2025-06-16",
      "accessed_at": "2026-10-26T20:05:49.476432+08:00",
      "primary_source": true,
      "applicability": "Reverse automatic differentiation follows the recorded graph. Detaching the target leaves the endpoint-to-input derivative intact; frozen weights do not remove input derivatives. Correct local derivatives alone do not imply that a time-varying stochastic trajectory decreases final geometric error."
    }
  ],
  "patches": [
    {
      "module": "analysis.md",
      "observation": "Representative private/synthesis texts repeatedly call the guidance/native statistic native/guidance and use window start/end endpoint loss as evidence of under/over-dosing. 3w54 R05 redistribute reduced W2 endpoint loss relative to R04 while final C and affinity gap both worsened.",
      "evidence": "Read all 30 aggregates and all four bound contexts. 3w54 R04/R05 redistribute: W2 terminal endpoint loss 0.0427956 -> 0.0380996, C 0.3376818 -> 0.3668618419766426, gap 0.7475746 -> 0.83144. Two windows changed, so individual causal effects remain unresolved. sampler.py defines delta_native_ratio as ||delta||/||native-before||.",
      "mechanism_applicability": "UniGuide differentiates the endpoint residual through the input Jacobian. The audited FLOWR update also multiplies by -dt*S*((1-t+1e-6)/t+gamma). Different time, state and assignment make window start/end losses different functions; no monotone final error follows. This is interpretation of the existing implementation.",
      "skill_edit": "Add the exact FLOWR correction and ratio direction, joint RMS/maximum/coefficient diagnosis, matched-prefix comparisons, coupled-redistribution caveat, and distinction between marginal and paired standard error.",
      "expected_behavior": "UG02 analyses use guidance/native consistently and justify window interventions using measured comparisons instead of interpreting loss drift alone as a dose signal.",
      "next_version_falsifier": "Read UG02 representative contexts and all selected proposals: the change fails behaviorally if a selected dose change is justified only by within-window loss drift, or ratios are still reversed. Outcome improvement remains unproven if representative C/gap do not improve under the frozen comparator."
    },
    {
      "module": "proposal.md",
      "observation": "The increase branch for 6pyy continued from an already unstable early-window anchor through five rounds, while later rounds of the 3w54 decrease branch continued below its better measured early scale.",
      "evidence": "6pyy R01-R04 increase retain W1=256 with W1 RMS 28.8905 A and maximum atom increment 4987.81 A; R05 increases W1 again and W1 RMS reaches 978.2686 A, final C 1.59201. R0 C=0.597012 and W1 RMS=0.393059 A. 3w54 decrease R02 C=0.38548, R03 C=0.47624, R04 C=0.47925, R05 C=0.49334. Alternative measured anchors are already allowed by proposal.md and validate_action.",
      "mechanism_applicability": "A branch direction is relative to its named measured anchor. Rebasing its proposal to a better completed schedule preserves the lattice and branch signs, while avoiding inherited upstream disturbance. Physical sampling still starts from the same R0 checkpoint; this is not a retry of a failed sample.",
      "skill_edit": "Require explicit consideration of a better current-version anchor when the default loses under the existing C-band/gap rule or contains extreme inherited increments; provide at least one useful local legal option and prefer one-window fine tests near reversals.",
      "expected_behavior": "UG02 spends fewer branch slots on known dominated continuations and more on untested neighboring schedules around supported regions, without importing old dynamic memories.",
      "next_version_falsifier": "Reject the anchor mechanism if UG02 continues a poor/extreme default anchor through two later rounds despite legal untested alternatives and no explicit information-gain justification, or if rebased local tests fail to improve C/gap. Do not alter the domain, rerun winners or relax action validation."
    },
    {
      "module": "synthesis.md",
      "observation": "6pyy advice_R04 synthesis selected a coarse W3-down/W4-up test based on presumed weak late correction; the measured result did not improve C or gap. 3w54 advice_R05 selected stronger W2/weaker W3 on a similar endpoint-loss narrative and final C/gap worsened.",
      "evidence": "6pyy R03/R04 redistribute C 0.5851634 -> 0.58775 and gap 2.2589444 -> 2.26370; 3w54 R04/R05 redistribute C 0.3376818 -> 0.36686 and gap 0.7475746 -> 0.83144. The 3w54 context also suggests a best-pIC50 gain could compensate a gap loss, which is not the frozen ranking rule.",
      "mechanism_applicability": "Prediction checking separates a valid local VJP from an unsupported hypothesis about final geometry or pIC50. The selector already has the current-version history and private candidates; improving its evidence discipline requires no sampler or schema changes.",
      "skill_edit": "Add explicit previous-prediction outcome checks, prefer matched evidence, retain the frozen ordering, compare candidate inherited disturbances, and label the ten-slot quality population and unknowns.",
      "expected_behavior": "UG02 synthesis states which mechanism was contradicted and selects an existing supported local option; it does not continue a disproved explanation or treat sampled diagnostic completion as universal quality.",
      "next_version_falsifier": "Inspect each next-round synthesis after a failed prediction: if it repeats the same dose narrative without acknowledging the measured counterexample, or changes the C/gap ranking using best pIC50, the skill update has failed. Sample counts must remain 10/50."
    }
