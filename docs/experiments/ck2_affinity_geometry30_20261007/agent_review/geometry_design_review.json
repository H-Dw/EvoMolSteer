  "verified_contract": {
    "time": "原始score t的已保存target head标签对应当步预测终点；控制及teacher目标是原生proposal x_(t+dt)。只含score 0…0.49、proposal 0.01…0.50；.49→.50为最后控制更新，.50→.51无参考、无注入，之后native续推。",
    "affinity": "源代码只使用离线已有head标签；运行奖励与新增reward-response日志均为坐标函数，没有额外每步模型/head调用、head反传或模型Jacobian。",
    "conditional_derivative": "预测终点anchor用于Hungarian槽位对应、最近teacher和先验；全部在该次坐标导数中固定。直接计算∂R(x_proposal|stopgrad(anchor))/∂x_proposal，不能称为完整FLOWR端点拉回。",
    "graph": "atom类型参数未用于三个奖励；不引入SMC、克隆或图选择门。原生类别/键转移仍由生成器决定。",
    "support": "全部活跃原子均为core_mask，属于全局坐标控制。noncore=0由支持定义造成，不能证明局部性或周围区域自由。",
    "reward_vs_affinity": "局部坐标步升高注册reward与最终预测head变好是两个不同验收量；当前数据/数值测试仅验证前者的可计算性。"
  },
  "formulas": {
    "features": "z(x)=[centroid(3), svec central covariance(6), pair radial kernels(5), 20 receptor landmark fields×3]，74维；分量分别以全窗口背景尺度s_j标准化。off-diagonal乘sqrt(2)。",
    "affinity_direction": "R_dir=Σ_j [w_j clip(mean_b((h_bj-l_bj)/v_bj),-3,3)] z_j(x)/s_j；时间导数不进入空间力。",
    "affinity_landmark": "q_hb=Σ_j w_j (z_j/s_j-h_bj)^2/v_bj，q_lb类似；R=τ[logsumexp_b(-q_hb/τ)-logsumexp_b(-q_lb/τ)]。",
    "affinity_landmark_label": "这是共享对角尺度的高/低score距离混合对比，不是已规范化Gaussian密度比；缺少各组件logdet正规化，不能冒称完整likelihood ratio。",
    "affinity_pointcloud_prior": "固定anchor的Hungarian匹配给出endpoint距离d_b²与proposal teacher T_b；π=softmax(-d_b²/T_endpoint+β(score_b-mean_score))，取最近k个teacher。",
    "affinity_pointcloud_reward": "q_b=mean_i ||x_i-T_bi||²；C_b=δ²(sqrt(1+q_b/δ²)-1)；R=τ logsumexp_b(logπ_b-C_b/τ)。",
    "units": "centroid/landmark soft distance: Å；shape tensor: Å²；radial fields/pair kernels: dimensionless。pointcloud q/C/τ及endpoint temperature为Å²，δ为Å；其他两种标准化特征奖励的τ为无量纲。",
    "field_semantics": "occupancy3/5实际为以受体landmark距离3/5Å为中心、宽度1Å的径向Gaussian壳核，不是球内原子数；softmin为带log(N)正规化的距离场而非严格最小距离。",
    "pointcloud_feature_role": "affinity_pointcloud的74维observables仅诊断。其梯度来自匹配的原始proposal坐标，geometry_block_weights不改变该family的reward；不能把它的效果归因于74维块权重。"
  },
