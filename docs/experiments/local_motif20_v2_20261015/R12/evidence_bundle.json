  "generation_contract": "Generated chemical graphs remain free. Matching initial input and native protocol does not mean matching or freezing the final graph.",
  "implemented_operators": {
    "local_moments": "Implemented and derivative-tested: squared local centroid displacement plus Frobenius covariance mismatch divided by source covariance trace (both A squared). Targets collective local shape, without individual-point-distance force; no elemental force or band parameter.",
    "orientation": "Implemented and derivative-tested: directed local neighbor rays toward observed teacher rays; dimensionless angular mismatch. Requires supplied orientation_triplets; no direct element force.",
    "pair_distance": "Implemented and derivative-tested: local pair-distance intervals around observed teacher distances, units A. Does not freeze bonds or graph.",
    "pocket_distance": "Implemented and derivative-tested: local selected-point distances to fixed pocket sites, compared with source distances within a proposed tolerance. Uses provided coordinates, NOT an interaction energy or established H bond.",
    "point_band": "Implemented and derivative-tested: squared excess of local point distance outside a calibrated spatial tolerance. A coordinate intervention to be tested, not a proven affinity rule.",
    "pointwise": "Implemented and derivative-tested: local Hungarian assignment, robust per-point distance to observed teacher coordinates. Units A; no chemical-role or energy assumption."
  },
  "learning_window": [
    0.0,
    0.5
  ],
  "matching_contract": "Hungarian maps generated atom points to teacher ligand points, NOT to pocket sites. For pocket_distance, every matched local ligand point is compared to every supplied pocket site. It is geometric, not a role-minimum field or an N-only force.",
  "operator_implementation": "    def evaluate(self,z,logits,mask,assignment=None):\n        p=self.program;target=z.new_tensor(self.target)\n        if assignment is None:\n            assignments=[]\n            with torch.no_grad():\n                probabilities=logits.log_softmax(-1).detach().cpu().numpy()\n                for b,(cloud,m) in enumerate(zip(z.detach().cpu().numpy(),mask.cpu().numpy())):\n                    ids=np.flatnonzero(m)\n                    if len(ids)<=len(self.slots):raise ValueError('Local support covers all generated atoms')\n                    cost=((cloud[ids,None]-self.target[None])**2).sum(-1)\n                    cost-=p['assignment_element_cost']*probabilities[b,ids][:,self.labels]\n                    rr,cc=linear_sum_assignment(cost);assignments.append(ids[rr[np.argsort(cc)]])\n            assignment=torch.as_tensor(np.asarray(assignments),device=z.device,dtype=torch.long)\n        points=z.gather(1,assignment[...,None].expand(-1,-1,3));delta=points-target\n        band=p['band_multiplier']*p['base_band_A'];operator=p['operator']\n        if operator=='pointwise':\n            d=p['dose']['pointcloud_delta_A'];q=delta.square().sum(-1)\n            value=(-d*d*(torch.sqrt(1+q/(d*d))-1)).mean(1);error=q.mean(1).sqrt()\n        elif operator=='point_band':\n            distance=delta.norm(dim=-1);excess=(distance-band).clamp_min(0)\n            value=-(excess**2).mean(1);error=excess.mean(1)\n        elif operator=='pocket_distance':\n            sites=z.new_tensor([s['coords_A'] for s in p['pocket_sites']])\n            distance=(points[:,:,None]-sites[None,None]).norm(dim=-1)\n            desired=(target[:,None]-sites[None]).norm(dim=-1)\n            excess=((distance-desired).abs()-band).clamp_min(0)\n            value=-(excess**2).mean((1,2));error=excess.mean((1,2))\n        elif operator=='pair_distance':\n            pair=torch.triu_indices(len(self.slots),len(self.slots),offset=1,device=z.device)\n            d=(points[:,pair[0]]-points[:,pair[1]]).norm(dim=-1)\n            desired=(target[pair[0]]-target[pair[1]]).norm(dim=-1)\n            excess=((d-desired).abs()-band).clamp_min(0)\n            value=-(excess**2).mean(1);error=excess.mean(1)\n        elif operator=='local_moments':\n            mean=points.mean(1);desired_mean=target.mean(0)\n            centered=points-mean[:,None];q=target-desired_mean\n            covariance=torch.einsum('bni,bnj->bij',centered,centered)/len(self.slots)\n            desired_cov=q.T@q/len(self.slots)\n            location=(mean-desired_mean).square().sum(-1)\n            shape=(covariance-desired_cov).square().sum((1,2))/desired_cov.trace().clamp_min(1e-8)\n            combined=location+p.get('moment_shape_weight',1.)*shape\n            error=combined.sqrt();value=-combined\n        else:\n            errors=[]\n            for center,a,b in p['orientation_triplets']:\n                i,j,k=[self.local[s] for s in (center,a,b)]\n                v=points[:,[j,k]]-points[:,i,None];q=target[[j,k]]-target[i]\n                v=v/v.norm(dim=-1,keepdim=True).clamp_min(1e-8);q=q/q.norm(dim=-1,keepdim=True).clamp_min(1e-8)\n                # Bond rays are directed; avoids arbitrary plane-normal signs.\n                errors.append((1-(v*q).sum(-1)-p['orientation_band']).clamp_min(0).square().mean(1))\n            error=torch.stack(errors,1).mean(1);value=-error\n        direct=torch.zeros_like(mask,dtype=torch.bool);direct.scatter_(1,assignment,True)\n        return value,{'assignment':assignment,'direct_mask':direct,'target_error':error,\n            'point_rms_A':delta.square().sum(-1).mean(1).sqrt()}\n",
  "parameter_path_semantics": {
    "assignment_element_cost": "Detached correspondence cost coefficient, not a direct elemental force.",
    "band_multiplier": "Target tolerance multiplier for point_band/pocket_distance/pair_distance only.",
