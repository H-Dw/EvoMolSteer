  "handoff": {
    "findings": [
      {
        "claim": "Endpoint high-versus-low integrated contrasts are signed and feature-specific rather than a single global shift: global_centroid_y is negative (q=0.0136, 21% positive batches) while global_centroid_x and global_centroid_z are not distinguishable from zero (q=0.257 and q=0.481). This is a directional coordinate contrast at the observed endpoint, not an absolute geometric descriptor.",
        "evidence_ids": [
          "endpoint_effects:1",
          "endpoint_effects:0",
          "endpoint_effects:2"
        ],
        "id": "F001",
        "priority": 1
      },
      {
        "claim": "Shape/anisotropy coordinates carry the strongest coherent endpoint contrasts: shape_yy is strongly negative (q=1.5e-5, 0% positive batches) and shape_xx negative (q=8.1e-4, 7% positive batches), with shape_yz also negative (q=0.035). These are consistent signed contrasts across batches, distinct from the null centroid_x/z rows.",
        "evidence_ids": [
          "endpoint_effects:4",
          "endpoint_effects:3",
          "endpoint_effects:8"
        ],
        "id": "F002",
        "priority": 2
      },
      {
        "claim": "Pair-kernel endpoint contrasts are positive and monotone in the short-to-mid range: pair_kernel_1.5 (q=1.5e-4, 100% positive batches), pair_kernel_2.5 (q=2.2e-5, 100%), pair_kernel_3.5 (q=9.8e-5, 100%) and pair_kernel_5.0 (q=3.7e-3, 86%), while pair_kernel_7.0 is negative (q=1.5e-4, 0%). The sign reversal at 7.0 A indicates a scale-dependent contrast rather than a uniform density increase.",
        "evidence_ids": [
          "endpoint_effects:9",
          "endpoint_effects:10",
          "endpoint_effects:11",
          "endpoint_effects:12",
          "endpoint_effects:13"
        ],
        "id": "F003",
        "priority": 3
      },
      {
        "claim": "Landmark occupancy and softmin contrasts are heterogeneous by landmark: landmark_00_occupancy3 is positive (q=2.4e-4, 100% positive batches) and landmark_00_softmin negative (q=8.1e-4, 0%), whereas landmark_01_occupancy3/5 and landmark_02_occupancy3/5 are negative (q=0.0037, 0.0056, 0.0026, 0.0026) and landmark_01/02/03_softmin are positive (q=0.043, 0.0046, 0.013). Occupancy and softmin at the same landmark carry opposite signs, so they are not redundant descriptors of one effect.",
        "evidence_ids": [
          "endpoint_effects:15",
          "endpoint_effects:14",
          "endpoint_effects:18",
          "endpoint_effects:19",
          "endpoint_effects:21",
          "endpoint_effects:22",
          "endpoint_effects:17",
          "endpoint_effects:20",
          "endpoint_effects:23"
        ],
        "id": "F004",
        "priority": 4
      },
      {
        "claim": "The declared objective is final predicted target affinity primary with validity and strain secondary under coordinate-only control; the endpoint contrasts above are coordinate-reward evidence, not measured affinity benefit, and no decoded terminal affinity labels are present in the delivered observations.",
        "evidence_ids": [
          "objective"
        ],
        "id": "F005",
        "priority": 5
      }
    ],
    "hypotheses": [
      {
        "direction": "increase short-range pair-kernel occupancy; decrease long-range (7.0 A) kernel; negative shape_yy/shape_xx",
        "evidence_ids": [
          "endpoint_effects:9",
          "endpoint_effects:10",
          "endpoint_effects:12",
          "endpoint_effects:13",
          "endpoint_effects:4",
          "endpoint_effects:3"
        ],
        "falsifier": "If a permitted endpoint-coordinate reward recipe that raises short-range pair-kernel occupancy does not also lower the 7.0 A kernel or does not reproduce the negative shape_yy/shape_xx contrast, the joint-pattern hypothesis fails.",
        "id": "H001",
        "observable": "endpoint high-versus-low integrated z for pair_kernel_1.5-5.0, pair_kernel_7.0 and shape_yy/shape_xx",
        "scope": "observed endpoint window [0.0,0.5], selection-node coordinate contrasts",
        "statement": "A signed endpoint coordinate contrast that increases short-range pair-kernel occupancy (1.5-5.0 A) while decreasing the 7.0 A kernel and shifting shape_yy/shape_xx negative is a coherent joint pattern, not an isolated marginal descriptor."
      },
      {
        "direction": "landmark_00 occupancy3 up with softmin down; landmark_01/02 occupancy down with softmin up",
        "evidence_ids": [
          "endpoint_effects:15",
          "endpoint_effects:14",
          "endpoint_effects:18",
          "endpoint_effects:19",
          "endpoint_effects:21",
          "endpoint_effects:22"
        ],
        "falsifier": "If occupancy and softmin at the same landmark move with the same sign under a permitted regional-attention recipe, the opposite-sign coupling claim fails.",
        "id": "H002",
        "observable": "endpoint high-versus-low integrated z for landmark_XX_occupancy3/5 and landmark_XX_softmin",
        "scope": "observed endpoint window, per-landmark regional attention",
        "statement": "Landmark occupancy and softmin contrasts at the same landmark are opposite-signed, so a landmark-attention reward that targets occupancy alone would not express the softmin component and vice versa."
      }
    ],
    "limitations": [
