        ],
        "id": "F002",
        "priority": 2
      },
      {
        "claim": "Queried landmark_00 and landmark_01 features show frequent sign changes (3-10) and strong sign conflicts (1-18) between first and last rate estimates, indicating non-monotone, batch-conflicted temporal behavior rather than a stable directional contrast.",
        "evidence_ids": [
          "continuous:0",
