      },
      {
        "claim": "Whole-window z magnitudes for the queried features are small (|z| < 0.65), so no queried coordinate feature shows a strong whole-window displacement on the supplied support.",
        "evidence_ids": [
          "continuous:0",
          "continuous:1",
          "continuous:2",
          "continuous:3",
          "continuous:4",
          "continuous:5",
          "continuous:6",
          "continuous:7",
