  "handoff": {
    "findings": [
      {
        "claim": "The learning window is [0.0, 0.5] with 50 observed score nodes at 0.01 spacing; the objective is final predicted target affinity primary, with validity and strain secondary and coordinate control only.",
        "evidence_ids": [
          "clocks",
          "objective"
        ],
        "id": "F001",
        "priority": 1
      },
      {
        "claim": "Across the 200 continuous-trend rows, no feature has an accepted polynomial fit (polynomial_accepted=false throughout the queried page), and relative_node_RMSE is large (0.29-0.99), so no smooth whole-window coordinate trajectory is established.",
        "evidence_ids": [
          "continuous:0",
