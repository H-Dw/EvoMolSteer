  "handoff": {
    "findings": [
      {
        "claim": "The learning window and score clock are [0.0, 0.5] with 50 observed score nodes at 0.01 spacing; curve support is [0.0, 0.49], so no extrapolation beyond the observed nodes is licensed.",
        "evidence_ids": [
          "clocks",
          "objective"
        ],
        "id": "F001",
        "priority": 1
      },
      {
        "claim": "The objective is final predicted target affinity primary, with validity and strain secondary and coordinate control only; coordinate contrasts are therefore proxies, not affinity measurements.",
        "evidence_ids": [
          "objective"
        ],
        "id": "F002",
        "priority": 1
      },
      {
        "claim": "The landmark_00_soft_mass curve over the observed support [0.0, 0.49] rises from about -0.37 z early to a peak near +1.64 z around node 0.16, then declines to about -0.28 z at the last node, with 4 sign changes and only 1 strong sign conflict; the whole-window z is small (about 0.64) and no polynomial is accepted.",
        "evidence_ids": [
          "continuous:0",
          "curve_support"
        ],
        "id": "F003",
        "priority": 2
      },
      {
        "claim": "Across the 20 landmark soft-mass features, whole-window z magnitudes are small (largest |z| about 0.64 for landmark_00_soft_mass) and no polynomial trend is accepted for any feature, so no landmark soft-mass feature shows a stable whole-window monotone drift.",
        "evidence_ids": [
          "continuous:0",
          "continuous:70",
          "continuous:100",
          "continuous:110",
          "continuous:170",
          "continuous:30",
          "continuous:120",
          "continuous:10",
          "continuous:130",
          "continuous:40",
          "continuous:20",
          "continuous:60",
          "continuous:160",
          "continuous:180",
          "continuous:150",
          "continuous:90",
          "continuous:190",
          "continuous:50",
          "continuous:140",
          "continuous:80"
        ],
        "id": "F004",
        "priority": 2
      },
      {
        "claim": "Endpoint rate contrasts are large and sign-changing: e.g. landmark_00_soft_mass first_rate_z about +9.3 and last_rate_z about -10.0 with 4 sign changes, and landmark_10_soft_mass first_rate_z about +66.3 and last_rate_z about -11.6 with 4 sign changes; these are changing contrasts, not a stationary target.",
        "evidence_ids": [
          "continuous:0",
          "continuous:100"
        ],
        "id": "F005",
        "priority": 2
      },
      {
        "claim": "Strong sign conflicts are present for most landmarks (e.g. 17 for landmark_15_soft_mass, 14 for landmark_09_soft_mass, 11 for landmark_04_soft_mass), and relative node RMSE is high (about 0.29 to 0.99), so per-landmark temporal direction is not reproducible across batches.",
        "evidence_ids": [
          "continuous:150",
          "continuous:90",
          "continuous:40"
        ],
        "id": "F006",
        "priority": 3
      },
      {
        "claim": "Stage profiles and temporal profiles are not available in this delivery; only continuous curves and summary tables are supplied, so no data-derived stage knot is supported.",
        "evidence_ids": [
          "clocks"
        ],
        "id": "F007",
        "priority": 3
      }
    ],
    "hypotheses": [
      {
        "direction": "test staged blend of observed-forecast and static teachers; do not reverse the affinity objective",
        "evidence_ids": [
          "continuous:0",
          "curve_support",
          "clocks"
        ],
        "falsifier": "if the staged blend produces no reproducible change in the landmark_00_soft_mass contrast trajectory versus the constant-blend control at fixed dose, the stage-dependent relevance is not supported",
        "id": "H001",
        "observable": "landmark_00_soft_mass endpoint contrast curve over score nodes 0.0-0.49",
        "scope": "all seeds on the observed score nodes; no extrapolation",
        "statement": "A stage-dependent teacher-relevance schedule (early same-clock historical forecasts blending toward frozen static teachers) is worth testing at fixed dose, because the observed landmark_00_soft_mass contrast rises then falls within the window rather than holding a stationary direction."
      },
      {
        "direction": "test regional rather than global delta_A change",
        "evidence_ids": [
          "continuous:0",
          "curve_support",
          "continuous:70",
          "continuous:150"
        ],
        "falsifier": "if no landmark shows a reproducible low-conflict regional shift, delta_A change is not supported",
        "id": "H002",
        "observable": "per-landmark soft-mass contrast spread and sign-change count across the window",
        "scope": "landmarks with low strong_sign_conflicts and stable sign profile",
        "statement": "A geometric response-scale (delta_A) change is worth testing only if the soft-mass contrast spread and covariance show a reproducible regional shift; current whole-window z values are small and sign conflicts are high, so a global delta change is not yet justified."
      }
    ],
    "limitations": [
      "No decoded final affinity labels are available; selection and survival are not evidence of final affinity improvement.",
      "Stage profiles and temporal profiles are absent, so no data-derived stage boundary can be claimed.",
      "Coordinate contrasts are untyped proxies; no energy or chemical-interaction interpretation is made.",
      "Whole-window z values are small and polynomial trends are rejected, so no absolute coordinate target or spatial gradient is inferred from the contrast curves."
    ],
    "role": "Analyst"
  },
