{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvoMolSteer FLOWR.ROOT generation input",
  "type": "object",
  "additionalProperties": false,
  "required": ["flowr_root", "checkpoint", "input_dataset", "output_dataset"],
  "properties": {
    "flowr_root": {"type": "string", "minLength": 1},
    "python_executable": {"type": "string", "minLength": 1},
    "checkpoint": {"type": "string", "minLength": 1},
    "input_dataset": {"type": "string", "minLength": 1},
    "output_dataset": {"type": "string", "minLength": 1},
    "campaign": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "samples": {"type": "integer", "minimum": 1},
    "batch_size": {"type": "integer", "minimum": 1},
    "steps": {"type": "integer", "minimum": 2},
    "window_start": {"type": "number", "minimum": 0, "maximum": 1},
    "window_end": {"type": "number", "minimum": 0, "maximum": 1},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "arms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["unguided", "single", "joint"]}},
    "verify_passive": {"type": "boolean"}
  }
}
